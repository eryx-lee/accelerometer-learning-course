# Hosted Supabase injects the first three values automatically. They are shown
# only to document local `supabase functions serve --env-file` requirements.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=SET_LOCALLY_OR_AS_A_HOSTED_SECRET_NEVER_COMMIT_THE_REAL_VALUE

COURSE_ALLOWED_ORIGIN=https://uiuclapasssta.github.io
PUBLIC_CERTIFICATE_VERIFY_PAGE_URL=https://uiuclapasssta.github.io/accelerometer-learning-course/verify.html
CERTIFICATE_SIGNING_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES_AND_SET_WITH_SUPABASE_SECRETS
VERIFIER_RATE_LIMIT_SECRET=GENERATE_A_SEPARATE_AT_LEAST_32_BYTE_SECRET

# Local Auth emulation only. Configure the real values in Supabase Auth, never
# in GitHub Pages, course-data-config.js, or a committed env file.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=YOUR_GITHUB_OAUTH_APP_CLIENT_ID
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=YOUR_GITHUB_OAUTH_APP_SECRET
